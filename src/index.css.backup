/* =========================================================
   FARM2FRESH — COMPLETE CONSUMER UI
========================================================= */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&display=swap');


/* =========================================================
   ROOT
========================================================= */

:root {
  font-family: "DM Sans", sans-serif;

  color: #173d2c;
  background: #f7f6ef;

  font-synthesis: none;
  text-rendering: optimizeLegibility;

  --green: #167c4d;
  --dark-green: #0d4c32;
  --light-green: #e8f4e7;
  --cream: #f7f6ef;
  --white: #ffffff;
  --muted: #718078;
  --border: #dfe4db;
  --shadow: 0 15px 40px rgba(25, 65, 45, 0.08);
}


/* =========================================================
   RESET
========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--cream);
  color: #173d2c;
}

button,
input {
  font-family: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}


/* =========================================================
   GLOBAL
========================================================= */

.eyebrow {
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2.5px;
  margin-bottom: 15px;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2 {
  letter-spacing: -2px;
}

i {
  font-family: "Playfair Display", serif;
  font-weight: 600;
}


/* =========================================================
   NAVBAR
========================================================= */

.navbar {
  width: 100%;
  height: 78px;

  padding: 0 7%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(247, 246, 239, 0.94);

  border-bottom: 1px solid rgba(210, 218, 208, 0.7);

  position: sticky;
  top: 0;
  z-index: 1000;

  backdrop-filter: blur(15px);
}

.logo {
  display: flex;
  align-items: center;
  gap: 11px;
  cursor: pointer;
}

.logo-icon {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 14px;

  background: #dcefd9;

  font-size: 22px;
}

.logo strong {
  display: block;
  color: #12472f;
  font-size: 18px;
  line-height: 1;
}

.logo small {
  display: block;
  margin-top: 5px;

  color: #809087;

  font-size: 7px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.nav-links {
  display: flex;
  gap: 30px;
}

.nav-links button {
  border: 0;
  background: transparent;

  color: #62736a;

  font-size: 12px;
  font-weight: 600;

  transition: 0.25s;
}

.nav-links button:hover {
  color: var(--green);
}

.cart {
  position: relative;

  width: 45px;
  height: 45px;

  border: 1px solid var(--border);

  border-radius: 14px;

  background: white;

  font-size: 18px;

  transition: 0.25s;
}

.cart:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.cart span {
  position: absolute;

  right: -6px;
  top: -7px;

  min-width: 20px;
  height: 20px;

  padding: 0 5px;

  border-radius: 50%;

  background: #167c4d;
  color: white;

  font-size: 10px;
  font-weight: 800;

  display: grid;
  place-items: center;
}


/* =========================================================
   HERO
========================================================= */

.hero {
  min-height: 650px;

  padding: 75px 7%;

  display: grid;
  grid-template-columns: 1fr 0.9fr;

  gap: 70px;

  align-items: center;

  overflow: hidden;
}

.hero h1 {
  color: #104a32;

  font-size: clamp(55px, 6vw, 86px);

  line-height: 0.95;

  margin-bottom: 28px;
}

.hero h1 i {
  color: var(--green);
}

.hero-description {
  max-width: 550px;

  color: #718078;

  font-size: 15px;

  line-height: 1.8;

  margin-bottom: 30px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 20px;

  flex-wrap: wrap;
}

.primary {
  border: 0;

  padding: 15px 23px;

  border-radius: 13px;

  background: var(--green);
  color: white;

  font-weight: 700;
  font-size: 12px;

  box-shadow: 0 12px 25px rgba(22, 124, 77, 0.18);

  transition: 0.25s;
}

.primary:hover {
  background: #0f6840;
  transform: translateY(-2px);
}

.hero-note {
  color: #7b8982;

  font-size: 11px;
  line-height: 1.7;
}

.hero-stats {
  display: flex;

  gap: 40px;

  margin-top: 55px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-stats strong {
  color: #145c3c;

  font-size: 25px;
}

.hero-stats span {
  color: #8a968f;

  font-size: 9px;
  font-weight: 600;
}


/* =========================================================
   HERO IMAGE
========================================================= */

.hero-visual {
  position: relative;

  min-height: 480px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-image-card {
  width: min(100%, 520px);
  height: 470px;

  overflow: hidden;

  border-radius: 35px;

  background: #dcebd7;

  box-shadow: 0 30px 70px rgba(30, 65, 45, 0.12);

  transform: rotate(2deg);
}

.hero-image-card img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: 0.6s;
}

.hero-image-card:hover img {
  transform: scale(1.06);
}

.hero-floating-card {
  position: absolute;

  left: 5%;
  bottom: 20px;

  padding: 17px 20px;

  display: flex;
  align-items: center;
  gap: 12px;

  background: rgba(255, 255, 255, 0.94);

  border: 1px solid #e0e6dc;

  border-radius: 17px;

  box-shadow: 0 15px 35px rgba(20, 60, 40, 0.12);

  backdrop-filter: blur(10px);
}

.hero-floating-card > span {
  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background: #e5f3df;

  font-size: 20px;
}

.hero-floating-card strong {
  display: block;

  color: #24523d;

  font-size: 11px;
}

.hero-floating-card small {
  display: block;

  margin-top: 3px;

  color: #89958e;

  font-size: 9px;
}


/* =========================================================
   CATEGORY SECTION
========================================================= */

.category-section {
  padding: 70px 7% 35px;

  background: white;
}

.section-heading {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 25px;

  margin-bottom: 35px;
}

.section-heading h2 {
  color: #164b35;

  font-size: clamp(36px, 4vw, 50px);

  line-height: 1;
}

.section-heading h2 i {
  color: var(--green);
}

.search-box {
  min-width: 280px;

  padding: 12px 16px;

  display: flex;
  align-items: center;
  gap: 8px;

  border: 1px solid var(--border);

  border-radius: 13px;

  background: #fafbf8;
}

.search-box input {
  width: 100%;

  border: 0;
  outline: 0;

  background: transparent;

  color: #264c3b;

  font-size: 11px;
}

.search-box input::placeholder {
  color: #9ba59f;
}

.categories {
  display: flex;

  gap: 12px;

  overflow-x: auto;

  padding-bottom: 10px;
}

.category {
  padding: 12px 18px;

  display: flex;
  align-items: center;
  gap: 8px;

  white-space: nowrap;

  border: 1px solid var(--border);

  border-radius: 14px;

  background: #f8f9f5;

  color: #62746a;

  font-size: 11px;
  font-weight: 700;

  transition: 0.25s;
}

.category span {
  font-size: 18px;
}

.category:hover,
.category.active {
  background: var(--green);
  border-color: var(--green);
  color: white;

  transform: translateY(-2px);
}


/* =========================================================
   PRODUCTS
========================================================= */

.products-section {
  padding: 65px 7% 90px;

  background: white;
}

.product-count {
  color: #8a968f;

  font-size: 11px;
}

.product-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 22px;
}

.product-card {
  overflow: hidden;

  border: 1px solid #e2e6df;

  border-radius: 23px;

  background: white;

  transition: 0.3s;

  box-shadow: 0 5px 20px rgba(20, 60, 40, 0.03);
}

.product-card:hover {
  transform: translateY(-7px);

  box-shadow: 0 20px 45px rgba(25, 65, 45, 0.11);
}

.product-card-image {
  height: 235px;

  position: relative;

  overflow: hidden;

  cursor: pointer;

  background: #e8f1e3;
}

.product-card-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: 0.5s;
}

.product-card:hover .product-card-image img {
  transform: scale(1.07);
}

.product-tag {
  position: absolute;

  left: 14px;
  top: 14px;

  padding: 7px 10px;

  border-radius: 20px;

  background: rgba(255, 255, 255, 0.9);

  color: #22734e;

  font-size: 8px;
  font-weight: 800;

  backdrop-filter: blur(8px);
}

.product-card-content {
  padding: 18px;
}

.product-card-top {
  display: flex;

  justify-content: space-between;

  gap: 10px;
}

.product-card-top h3 {
  color: #194932;

  font-size: 17px;

  margin-bottom: 5px;
}

.product-card-top p {
  color: #89958e;

  font-size: 10px;
}

.card-rating {
  white-space: nowrap;

  color: #8a7442;

  font-size: 10px;
}

.product-location {
  margin-top: 12px;

  color: #84918a;

  font-size: 9px;
}

.product-card-bottom {
  margin-top: 18px;

  padding-top: 15px;

  border-top: 1px solid #edf0ea;

  display: flex;

  align-items: center;

  justify-content: space-between;
}

.product-card-bottom strong {
  color: #15754b;

  font-size: 23px;
}

.product-card-bottom small {
  color: #8b958f;

  font-size: 9px;
}

.product-card-bottom del {
  margin-left: 7px;

  color: #a7afa9;

  font-size: 10px;
}

.add-button {
  border: 0;

  padding: 10px 14px;

  border-radius: 11px;

  background: #e7f3e6;

  color: #14734a;

  font-size: 10px;

  font-weight: 800;

  transition: 0.2s;
}

.add-button:hover {
  background: var(--green);
  color: white;
}


/* =========================================================
   PRICE TRANSPARENCY
========================================================= */

.price-transparency {
  padding: 100px 7%;

  background: #f7f6ef;
}

.transparency-heading {
  max-width: 650px;

  margin-bottom: 45px;
}

.transparency-heading h2 {
  color: #164b35;

  font-size: clamp(40px, 5vw, 60px);

  line-height: 1.02;

  margin-bottom: 18px;
}

.transparency-heading h2 i {
  color: var(--green);
}

.transparency-heading > p:last-child {
  color: #74847b;

  line-height: 1.7;

  font-size: 14px;

  max-width: 560px;
}

.price-comparison {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 25px;
}

.price-box {
  padding: 30px;

  border-radius: 25px;

  border: 1px solid #dfe3d9;

  background: white;

  transition: 0.3s;
}

.price-box:hover {
  transform: translateY(-4px);

  box-shadow: var(--shadow);
}

.price-box.farm2fresh {
  background: #e8f4e7;

  border-color: #c5dec8;
}

.price-box-title {
  display: flex;

  align-items: center;

  gap: 14px;
}

.price-box-title > span {
  width: 50px;
  height: 50px;

  border-radius: 15px;

  background: #f1f2ec;

  display: grid;

  place-items: center;

  font-size: 25px;
}

.farm2fresh .price-box-title > span {
  background: white;
}

.price-box-title small {
  color: #89958e;

  font-size: 9px;

  letter-spacing: 2px;

  font-weight: 800;
}

.price-box-title h3 {
  margin-top: 5px;

  color: #244c39;

  font-size: 19px;
}

.supply-chain {
  margin: 30px 0;

  padding: 16px;

  border-radius: 15px;

  background: #f6f7f2;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  flex-wrap: wrap;

  color: #62746a;

  font-size: 10px;
}

.farm2fresh .supply-chain {
  background: white;
}

.supply-chain b {
  color: #a3ada7;
}

.price-lines {
  border-top: 1px solid #e6e8e1;
}

.price-lines div {
  display: flex;

  justify-content: space-between;

  padding: 14px 0;

  border-bottom: 1px solid #e6e8e1;
}

.price-lines span {
  color: #718078;

  font-size: 12px;
}

.price-lines strong {
  color: #294d3d;

  font-size: 13px;
}

.consumer-price {
  margin-top: 20px;

  padding: 17px;

  background: #f2f3ed;

  border-radius: 14px;

  display: flex;

  justify-content: space-between;

  align-items: center;
}

.farm2fresh .consumer-price {
  background: white;
}

.consumer-price span {
  color: #65776d;

  font-size: 12px;
}

.consumer-price strong {
  color: #14754b;

  font-size: 22px;
}

.transparency-benefits {
  margin-top: 25px;

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 15px;
}

.transparency-benefits div {
  background: white;

  border: 1px solid #e0e3da;

  padding: 22px;

  border-radius: 17px;
}

.transparency-benefits strong {
  display: block;

  font-size: 24px;

  color: #15774c;
}

.transparency-benefits span {
  display: block;

  color: #7b8982;

  font-size: 10px;

  margin-top: 5px;
}


/* =========================================================
   HOW IT WORKS
========================================================= */

.how-section {
  padding: 90px 7%;

  background: white;
}

.how-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 18px;
}

.how-card {
  position: relative;

  padding: 30px;

  min-height: 260px;

  border: 1px solid #e2e7df;

  border-radius: 22px;

  background: #fbfcf9;

  transition: 0.3s;
}

.how-card:hover {
  transform: translateY(-6px);

  background: #eff8ed;

  box-shadow: var(--shadow);
}

.how-card > span {
  position: absolute;

  top: 20px;
  right: 22px;

  color: #bdc9c0;

  font-size: 10px;

  font-weight: 800;
}

.how-card > div {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  border-radius: 16px;

  background: #e5f2e2;

  font-size: 23px;

  margin-bottom: 24px;
}

.how-card h3 {
  color: #204c38;

  font-size: 17px;

  margin-bottom: 10px;
}

.how-card p {
  color: #7c8982;

  font-size: 11px;

  line-height: 1.7;
}


/* =========================================================
   AI BANNER
========================================================= */

.ai-banner {
  margin: 0 7% 90px;

  padding: 45px;

  display: grid;

  grid-template-columns: auto 1fr 1fr;

  align-items: center;

  gap: 30px;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      #e3f3df,
      #f5f7ec
    );

  border: 1px solid #d3e4d0;
}

.ai-banner-icon {
  width: 75px;
  height: 75px;

  display: grid;
  place-items: center;

  border-radius: 23px;

  background: white;

  font-size: 35px;

  box-shadow: var(--shadow);
}

.ai-banner h2 {
  color: #174d35;

  font-size: 42px;

  line-height: 1;
}

.ai-banner h2 i {
  color: var(--green);
}

.ai-banner .eyebrow {
  margin-bottom: 10px;
}


/* =========================================================
   FOOTER
========================================================= */

.footer {
  padding: 45px 7%;

  background: #123c2a;

  color: white;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 40px;
}

.footer .logo strong {
  color: white;
}

.footer .logo small {
  color: #a6bdb0;
}

.footer p {
  margin-top: 14px;

  color: #9bb2a6;

  font-size: 10px;
}

.footer-links {
  display: flex;

  flex-wrap: wrap;

  justify-content: flex-end;

  gap: 12px;
}

.footer-links span {
  padding: 9px 12px;

  border-radius: 10px;

  background: rgba(255, 255, 255, 0.07);

  color: #bdd0c5;

  font-size: 9px;
}


/* =========================================================
   PRODUCT DETAIL
========================================================= */

.product-detail {
  padding: 40px 7% 90px;
}

.back-home {
  border: 0;

  background: transparent;

  color: #236346;

  font-weight: 700;

  font-size: 11px;

  margin-bottom: 35px;
}

.product-detail-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 60px;

  align-items: center;
}

.product-image-large {
  position: relative;

  height: 560px;

  overflow: hidden;

  border-radius: 32px;

  background: #dbead7;

  box-shadow: var(--shadow);
}

.product-image-large img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.fresh-badge {
  position: absolute;

  left: 25px;
  bottom: 25px;

  padding: 11px 16px;

  background: white;

  border-radius: 30px;

  color: #26724e;

  font-size: 10px;

  font-weight: 800;

  box-shadow: var(--shadow);
}

.product-info h1 {
  color: #12472f;

  font-size: clamp(45px, 5vw, 68px);

  line-height: 0.95;

  margin-bottom: 20px;
}

.product-description {
  color: #728078;

  font-size: 14px;

  line-height: 1.8;

  margin: 25px 0;
}

.price-card {
  padding: 22px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  border: 1px solid var(--border);

  border-radius: 18px;

  background: white;
}

.price-card small {
  color: #8b968f;

  font-size: 9px;
}

.big-price {
  margin-top: 5px;

  color: var(--green);

  font-size: 32px;

  font-weight: 800;
}

.big-price span {
  color: #8c9891;

  font-size: 11px;

  font-weight: 500;
}

.save-badge {
  padding: 9px 12px;

  border-radius: 20px;

  background: #e5f2e4;

  color: #24724d;

  font-size: 10px;

  font-weight: 800;
}

.ai-insight {
  margin-top: 15px;

  padding: 20px;

  display: flex;

  gap: 15px;

  border: 1px solid #cbe0cc;

  border-radius: 18px;

  background: #e8f4e7;
}

.ai-icon {
  width: 45px;
  height: 45px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 13px;

  background: white;

  font-size: 21px;
}

.ai-insight strong {
  color: #1b553a;

  font-size: 12px;
}

.ai-insight p {
  margin-top: 6px;

  color: #718178;

  font-size: 10px;

  line-height: 1.6;
}

.farmer-card {
  margin-top: 15px;

  padding: 18px;

  display: flex;

  align-items: center;

  gap: 13px;

  border: 1px solid var(--border);

  border-radius: 18px;

  background: white;
}

.farmer-avatar {
  width: 47px;
  height: 47px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #e6f1e2;

  font-size: 23px;
}

.farmer-card small {
  display: block;

  color: #8c9891;

  font-size: 7px;

  letter-spacing: 1.5px;
}

.farmer-card strong {
  display: block;

  margin-top: 4px;

  color: #25513c;

  font-size: 12px;
}

.farmer-card p {
  margin-top: 3px;

  color: #89958e;

  font-size: 9px;
}

.farmer-card button {
  margin-left: auto;

  border: 0;

  background: transparent;

  color: var(--green);

  font-size: 9px;

  font-weight: 800;
}

.add-cart-large {
  width: 100%;

  margin-top: 15px;

  padding: 16px;

  border: 0;

  border-radius: 14px;

  background: var(--green);

  color: white;

  font-size: 12px;

  font-weight: 800;

  transition: 0.25s;
}

.add-cart-large:hover {
  background: #0f6840;

  transform: translateY(-2px);
}

.product-features {
  margin-top: 16px;

  display: flex;

  justify-content: space-between;

  gap: 8px;
}

.product-features span {
  color: #728078;

  font-size: 9px;
}


/* =========================================================
   CART PAGE
========================================================= */

.cart-page {
  min-height: 100vh;

  background: var(--cream);
}

.cart-container {
  padding: 60px 7% 100px;
}

.cart-header {
  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 30px;

  margin-bottom: 45px;
}

.cart-header h1 {
  color: #12472f;

  font-size: 58px;

  line-height: 1;
}

.cart-header h1 i {
  color: var(--green);
}

.cart-subtitle {
  margin-top: 12px;

  color: #78867e;

  font-size: 12px;
}

.cart-trust {
  padding: 15px 18px;

  display: flex;

  align-items: center;

  gap: 12px;

  border: 1px solid #dfe6dc;

  border-radius: 16px;

  background: white;
}

.cart-trust > span {
  font-size: 25px;
}

.cart-trust strong {
  display: block;

  color: #28533e;

  font-size: 10px;
}

.cart-trust small {
  display: block;

  margin-top: 3px;

  color: #8b968f;

  font-size: 8px;
}

.cart-layout {
  display: grid;

  grid-template-columns: 1.5fr 0.7fr;

  gap: 25px;

  align-items: start;
}

.cart-items {
  display: flex;

  flex-direction: column;

  gap: 12px;
}

.cart-items-header {
  padding: 0 10px 10px;

  display: flex;

  justify-content: space-between;

  color: #8b968f;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 1.5px;
}

.cart-item {
  padding: 15px;

  display: grid;

  grid-template-columns: 85px 1fr auto auto auto;

  align-items: center;

  gap: 18px;

  border: 1px solid #e0e5dd;

  border-radius: 19px;

  background: white;
}

.cart-product-image {
  width: 85px;
  height: 85px;

  position: relative;

  overflow: hidden;

  border-radius: 14px;

  background: #eaf2e6;
}

.cart-product-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.cart-product-image span {
  position: absolute;

  left: 5px;
  bottom: 5px;

  padding: 4px 6px;

  border-radius: 7px;

  background: white;

  color: #21704b;

  font-size: 6px;

  font-weight: 800;
}

.cart-item-info h3 {
  color: #234d39;

  font-size: 14px;
}

.cart-item-info p {
  margin-top: 5px;

  color: #6e8076;

  font-size: 9px;
}

.cart-item-info small {
  display: block;

  margin-top: 3px;

  color: #919c96;

  font-size: 8px;
}

.delivery-mini {
  margin-top: 8px;

  color: #3e8a61;

  font-size: 8px;
}

.quantity-control {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 5px;

  border: 1px solid #e1e6df;

  border-radius: 10px;
}

.quantity-control button {
  width: 25px;
  height: 25px;

  border: 0;

  border-radius: 7px;

  background: #edf4ea;

  color: #26744d;

  font-weight: 800;
}

.quantity-control span {
  min-width: 15px;

  text-align: center;

  font-size: 10px;

  font-weight: 700;
}

.cart-price {
  min-width: 75px;

  text-align: right;
}

.cart-price strong {
  display: block;

  color: #16754b;

  font-size: 16px;
}

.cart-price small {
  color: #8c9791;

  font-size: 8px;
}

.remove {
  width: 27px;
  height: 27px;

  border: 0;

  border-radius: 8px;

  background: #f7eeee;

  color: #b26464;

  font-size: 18px;

  line-height: 1;
}

.order-summary {
  padding: 25px;

  position: sticky;
  top: 100px;

  border: 1px solid #dfe5dc;

  border-radius: 22px;

  background: white;

  box-shadow: 0 10px 30px rgba(25, 65, 45, 0.05);
}

.order-summary h2 {
  color: #234d39;

  font-size: 21px;

  letter-spacing: -1px;

  margin-bottom: 25px;
}

.summary-row {
  padding: 12px 0;

  display: flex;

  justify-content: space-between;

  border-bottom: 1px solid #edf0eb;

  color: #7b8982;

  font-size: 10px;
}

.summary-row strong {
  color: #2c4d3e;
}

.summary-row .benefit {
  color: #2b8a5b;
}

.order-summary hr {
  border: 0;

  border-top: 1px solid #dfe5dc;

  margin: 8px 0;
}

.summary-total {
  padding: 15px 0;

  display: flex;

  align-items: center;

  justify-content: space-between;
}

.summary-total span {
  color: #496052;

  font-size: 12px;

  font-weight: 700;
}

.summary-total strong {
  color: #13754b;

  font-size: 25px;
}

.checkout {
  width: 100%;

  padding: 15px;

  border: 0;

  border-radius: 13px;

  background: var(--green);

  color: white;

  display: flex;

  justify-content: space-between;

  align-items: center;

  font-size: 11px;

  font-weight: 800;

  transition: 0.25s;
}

.checkout:hover {
  background: #0e6840;

  transform: translateY(-2px);
}

.secure {
  margin-top: 15px;

  text-align: center;

  color: #9aa49e;

  font-size: 8px;
}


/* =========================================================
   EMPTY CART / SUCCESS
========================================================= */

.empty-cart {
  min-height: 400px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 50px;
}

.empty-cart-icon {
  width: 90px;
  height: 90px;

  display: grid;
  place-items: center;

  margin-bottom: 20px;

  border-radius: 30px;

  background: #e6f2e3;

  font-size: 42px;
}

.empty-cart h2 {
  color: #204d39;

  font-size: 28px;

  margin-bottom: 10px;
}

.empty-cart p {
  max-width: 400px;

  color: #829088;

  font-size: 11px;

  line-height: 1.7;

  margin-bottom: 22px;
}


/* =========================================================
   RESPONSIVE — TABLET
========================================================= */

@media (max-width: 1000px) {

  .nav-links {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;

    gap: 40px;
  }

  .hero-visual {
    min-height: 400px;
  }

  .product-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .how-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .cart-layout {
    grid-template-columns: 1fr;
  }

  .order-summary {
    position: static;
  }

  .product-detail-grid {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .product-image-large {
    height: 450px;
  }

  .ai-banner {
    grid-template-columns: auto 1fr;
  }

  .ai-banner > p {
    grid-column: 1 / -1;
  }

}


/* =========================================================
   RESPONSIVE — MOBILE
========================================================= */

@media (max-width: 700px) {

  .navbar {
    height: 68px;

    padding: 0 5%;
  }

  .logo-icon {
    width: 37px;
    height: 37px;

    border-radius: 11px;
  }

  .logo strong {
    font-size: 15px;
  }

  .logo small {
    font-size: 6px;
  }


  /* HERO */

  .hero {
    padding: 55px 5% 65px;

    min-height: auto;
  }

  .hero h1 {
    font-size: 55px;
  }

  .hero-description {
    font-size: 13px;
  }

  .hero-stats {
    gap: 22px;

    margin-top: 35px;
  }

  .hero-stats strong {
    font-size: 20px;
  }

  .hero-stats span {
    font-size: 8px;
  }

  .hero-visual {
    min-height: 330px;
  }

  .hero-image-card {
    height: 330px;

    border-radius: 25px;
  }

  .hero-floating-card {
    left: 0;

    bottom: 5px;
  }


  /* SECTION */

  .category-section,
  .products-section,
  .price-transparency,
  .how-section {
    padding-left: 5%;
    padding-right: 5%;
  }

  .section-heading {
    align-items: flex-start;

    flex-direction: column;
  }

  .search-box {
    width: 100%;

    min-width: 0;
  }


  /* PRODUCTS */

  .product-grid {
    grid-template-columns: 1fr;
  }

  .product-card-image {
    height: 250px;
  }


  /* TRANSPARENCY */

  .price-comparison {
    grid-template-columns: 1fr;
  }

  .transparency-heading h2 {
    font-size: 42px;
  }

  .transparency-benefits {
    grid-template-columns: 1fr 1fr;
  }

  .supply-chain {
    justify-content: flex-start;

    line-height: 1.8;
  }


  /* HOW */

  .how-grid {
    grid-template-columns: 1fr;
  }


  /* AI */

  .ai-banner {
    margin: 0 5% 60px;

    padding: 28px;

    grid-template-columns: 1fr;

    gap: 18px;
  }

  .ai-banner h2 {
    font-size: 35px;
  }


  /* PRODUCT DETAIL */

  .product-detail {
    padding: 25px 5% 60px;
  }

  .product-detail-grid {
    gap: 25px;
  }

  .product-image-large {
    height: 350px;

    border-radius: 24px;
  }

  .product-info h1 {
    font-size: 45px;
  }

  .product-features {
    flex-direction: column;
  }


  /* CART */

  .cart-container {
    padding: 40px 5% 70px;
  }

  .cart-header {
    align-items: flex-start;

    flex-direction: column;
  }

  .cart-header h1 {
    font-size: 45px;
  }

  .cart-trust {
    width: 100%;
  }

  .cart-item {
    grid-template-columns:
      70px 1fr auto;

    gap: 12px;

    padding: 12px;
  }

  .cart-product-image {
    width: 70px;
    height: 70px;
  }

  .quantity-control {
    grid-column: 2;

    justify-self: start;
  }

  .cart-price {
    grid-column: 3;
    grid-row: 1;

    min-width: auto;
  }

  .remove {
    grid-column: 3;
    grid-row: 2;

    justify-self: end;
  }


  /* FOOTER */

  .footer {
    padding: 40px 5%;

    flex-direction: column;

    align-items: flex-start;
  }

  .footer-links {
    justify-content: flex-start;
  }

}


/* =========================================================
   EXTRA SMALL
========================================================= */

@media (max-width: 430px) {

  .hero h1 {
    font-size: 47px;
  }

  .hero-stats {
    gap: 15px;
  }

  .hero-stats strong {
    font-size: 17px;
  }

  .transparency-benefits {
    grid-template-columns: 1fr;
  }

  .price-box {
    padding: 20px;
  }

  .price-box-title h3 {
    font-size: 16px;
  }

  .cart-item-info h3 {
    font-size: 12px;
  }

  .cart-price strong {
    font-size: 14px;
  }

}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero > div {
  animation: fadeUp 0.7s ease both;
}

.hero-visual {
  animation: fadeUp 0.9s ease both;
}

.product-card {
  animation: fadeUp 0.5s ease both;
}


/* =========================================================
   SELECTION
========================================================= */

::selection {
  background: #bfe1c5;
  color: #123c2a;
}


/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #f0f2eb;
}

::-webkit-scrollbar-thumb {
  background: #b8c8bc;

  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #7fa28c;
}